# Copy to .env; never commit it. Shabang works offline without this file.
# These are the supported desktop/server options. Historical loop/executor settings are deliberately omitted.

# Form decisions: provider precedence is TypeSafe direct, AI Gateway, Baseten, OpenAI/xAI, then the local heuristic.
AI_GATEWAY_API_KEY=          # Vercel AI Gateway, used for Jev (typesafe-ai/jev)
TYPESAFE_API_KEY=            # optional, direct TypeSafe access

# Text drafts and experimental vision. OPENAI_VISION_MODEL defaults to gpt-5.6-luna.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_VISION_MODEL=
SHABANG_VISION_BUDGET=       # optional, default 200 calls per process; 0 disables
SHABANG_VISION_CACHE=        # optional, default 200 entries; 0 disables

# xAI is an optional OpenAI-compatible text fallback when OPENAI_API_KEY is absent.
XAI_API_KEY=
XAI_BASE_URL=
XAI_MODEL=

# Baseten is optional for decisions and text. Each sample or hedge is an additional paid request.
BASETEN_API_KEY=
BASETEN_BASE_URL=
BASETEN_DECISION_MODEL=
BASETEN_TEXT_MODEL=
BASETEN_SAMPLES=             # default 3; valid range 1–8
BASETEN_HEDGE=               # default 1; valid range 0–4
BASETEN_DECISION_MODEL_URL=
BASETEN_LOGPROBS=            # set to 1 to request logprobs
SHABANG_WARMUP=              # set to 0 to skip the Baseten warm-up request

# Local-server behavior. Leave unset to keep the default loopback host and normal local fallback behavior.
SHABANG_HOST=
SHABANG_FAST_PATH=           # set to 0 to always ask the configured decision provider

# Optional server and demo observability. Unset means no Sentry SDK initialization.
SENTRY_DSN=
SENTRY_WEB_DSN=
SHABANG_ENV=                 # defaults to dev
SENTRY_ENVIRONMENT=          # legacy environment alias
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=
SENTRY_PROFILES_SAMPLE_RATE=
