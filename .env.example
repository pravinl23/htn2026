# Copy to .env (never commit .env). The offline form demo and server fallbacks work without keys;
# live model/cloud/API paths require the corresponding credentials.
AI_GATEWAY_API_KEY=      # Vercel AI Gateway, used for Jev (model typesafe-ai/jev)
TYPESAFE_API_KEY=        # optional, direct TypeSafe access once off the waitlist
OPENAI_API_KEY=          # free-text ghost text, resume extraction, loop generalization
OPENAI_VISION_MODEL=     # optional, defaults to gpt-5.6-luna; vision fallback /v1/vision/* (docs/openai.md), needs OPENAI_API_KEY; GHOST_VISION_BUDGET caps calls per process (default 200)
XAI_API_KEY=             # optional, xAI Grok via its OpenAI-compatible API; used for free text when OPENAI_API_KEY is unset
XAI_MODEL=               # optional, defaults to grok-4.20-non-reasoning
BROWSERBASE_API_KEY=     # optional, parallel loop execution (stage 8)
BROWSERBASE_PROJECT_ID=  # optional
BROWSERBASE_CONCURRENCY= # optional, default 5, clamped to 10
BROWSERBASE_CONTEXT_ID=  # optional read-only logged-in Browserbase context
SHABANG_PUBLIC_DEMO_URL=   # public demo origin used when Browserbase cannot reach localhost
COMPOSIO_API_KEY=        # optional, compile loops to API calls (stage 8)
COMPOSIO_USER_ID=        # optional, defaults to default
COMPOSIO_GMAIL_ACCOUNT_ID=
COMPOSIO_GOOGLESHEETS_ACCOUNT_ID=
COMPOSIO_SPREADSHEET_ID=
COMPOSIO_SHEET_RANGE=    # optional, defaults to Sheet1
SHABANG_EXTENSION_ID=      # extension id allowed to start real loop executors
SHABANG_EXECUTE_TOKEN=     # 16+ character secret for trusted non-extension executor callers
BASETEN_API_KEY=         # Baseten Model APIs (OpenAI-compatible): hedged self-consistency decisions + streamed ghost text. See docs/baseten.md
BASETEN_BASE_URL=        # optional, defaults to https://inference.baseten.co/v1
BASETEN_DECISION_MODEL=  # optional, defaults to zai-org/GLM-5.3-Flash (thinking can be switched off per request)
BASETEN_TEXT_MODEL=      # optional, defaults to zai-org/GLM-5.3-Flash
BASETEN_SAMPLES=         # optional, K: parallel samples per decision, default 3 (1 to 8). Below 3 no ghost passes the 0.7 gate
BASETEN_HEDGE=           # optional, H: extra hedge requests per decision, default 1 (0 to 4). One decision costs K + H requests
BASETEN_DECISION_MODEL_URL= # optional, OpenAI-compatible base URL of a dedicated deployment (our own Tab model); decisions only
BASETEN_LOGPROBS=        # optional, 1 asks for logprobs and uses them if a response carries them (the Model APIs return none today)
SHABANG_WARMUP=            # optional, 0 skips the one warm-up request the server sends at start when Baseten decides
SENTRY_DSN=              # optional, Node project "ghost-server": traces, logs, metrics, errors for the prediction server (docs/observability.md). Unset = complete no-op
SENTRY_WEB_DSN=          # optional, React project "ghost-web": error monitoring + session replay for the demo web build
GHOST_ENV=               # optional, Sentry environment tag, defaults to dev (use demo for a recorded run)
SENTRY_ENVIRONMENT=      # optional, older alias for GHOST_ENV (for example hackathon or production)
SENTRY_RELEASE=          # optional, defaults to the git short sha read from .git
SENTRY_TRACES_SAMPLE_RATE=   # optional, 0 to 1, defaults to 1 (every request is traced; the demo is a handful of requests)
SENTRY_PROFILES_SAMPLE_RATE= # optional, 0 to 1, defaults to 1; 0 switches profiling off. Profiles need an LTS Node (even major)
