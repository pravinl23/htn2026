#!/bin/sh
# ghostctl: drive Ghost Desktop without a mouse (docs/desktop-realworld.md section 2).
#
#   ghostctl trust                         { "trusted": bool }
#   ghostctl dump      [options]           captured fields of the frontmost window (labels, never values)
#   ghostctl dump-tree [options]           raw AX tree, values reduced to their length
#   ghostctl autotab N [options]           N real Tab presses through Ghost, one record per press; stops at a lock
#   ghostctl probe-combobox "How did" [options]   open ONE combo box, record what the AX tree shows, close it
#   ghostctl run                           start the menu-bar agent (a second copy exits on its own)
#   ghostctl quit                          stop every Ghost process
#   ghostctl log [LINES]                   tail ~/Library/Logs/Ghost/desktop.log
#   ghostctl selftest                      core + mapping self-test (needs no permission)
#
#   options: --frontmost "App"  --expect-field "First Name"  --delay S  --interval MS  --depth N  --out FILE  --timeout S
#
#   --expect-field pins the PAGE. --frontmost only promises the APP is in front, never which tab: with
#   --expect-field the harness re-captures the window before the first Tab and before every later press and
#   refuses to post unless a captured label still matches, so a tab that changed costs zero keystrokes
#   ("stopped": "expect-field-missing"). Use it for every live run on a real site.
#
# Everything is launched through LaunchServices (`open -n ... --args`), never as a child of this shell: macOS
# judges a binary started from a terminal by the TERMINAL's Accessibility permission, not by Ghost's. Such a
# launch has no stdout, so the answer travels through --out; this script waits for that file and prints it.
# Exit status: 0 answer without an error, 1 answer with "error" (not trusted, locked out...), 2 no answer, 64 usage.
# This script never sends a key itself, and the harness can only ever send Tab.
set -eu

HERE="$(cd "$(dirname "$0")" && pwd)"
DESKTOP="$(cd "$HERE/.." && pwd)"
APP="${GHOST_APP:-$DESKTOP/build/Ghost.app}"
SUPPORT="$HOME/Library/Application Support/Ghost"
LOG="$HOME/Library/Logs/Ghost/desktop.log"
PROCESS_PATTERN="Ghost.app/Contents/MacOS/Ghost"

usage() {
    sed -n '2,21p' "$0" | sed 's/^# \{0,1\}//'
    exit 64
}

die() {
    echo "ghostctl: $*" >&2
    exit 64
}

# The library the host should load: $GHOST_LIB, else the fresh build, else whatever the host finds on its own
# (~/Library/Application Support/Ghost/libghost.dylib after `make install-lib`).
library() {
    if [ -n "${GHOST_LIB:-}" ]; then
        echo "$GHOST_LIB"
    elif [ -f "$DESKTOP/build/libghost.dylib" ]; then
        echo "$DESKTOP/build/libghost.dylib"
    fi
}

# launch [--args ...]: `open -n -g` (new instance, never brought to the front: the window under test keeps focus).
launch() {
    [ -d "$APP" ] || die "no $APP: run 'make -C desktop app' first"
    lib="$(library)"
    if [ -z "$lib" ]; then
        open -n -g "$APP" "$@"
    elif open -h 2>&1 | grep -q -- '--env'; then
        open -n -g --env GHOST_LIB="$lib" --env GHOST_NO_PROMPT=1 "$APP" "$@"
    else
        # No `open --env` on this macOS: the host reads the path from lib-path.txt (its last lookup location).
        mkdir -p "$SUPPORT"
        printf '%s\n' "$lib" > "$SUPPORT/lib-path.txt"
        open -n -g "$APP" "$@"
    fi
}

# harness MODE [N] [options]
harness() {
    mode="$1"; shift
    count=""; probe=""
    if [ "$mode" = "autotab" ]; then
        [ $# -ge 1 ] || die "autotab needs a count: ghostctl autotab 12"
        count="$1"; shift
        case "$count" in ''|*[!0-9]*) die "autotab needs a whole number, got '$count'";; esac
    elif [ "$mode" = "probe-combobox" ]; then
        [ $# -ge 1 ] || die "probe-combobox needs a label: ghostctl probe-combobox \"How did you hear\""
        probe="$1"; shift
    fi
    out=""; delay=0; interval=450; timeout=""; guarded=0
    set -- "$@" --end--
    while [ "$1" != "--end--" ]; do
        flag="$1"; shift
        case "$flag" in
            --out|--delay|--interval|--depth|--frontmost|--expect-field|--timeout)
                [ "$1" != "--end--" ] || die "$flag needs a value"
                value="$1"; shift
                case "$flag" in
                    --out) case "$value" in /*) out="$value";; *) out="$PWD/$value";; esac; continue;;
                    --timeout) timeout="$value"; continue;;
                    --delay) delay="$value";;
                    --interval) interval="$value";;
                    --expect-field) guarded=1;;
                esac
                set -- "$@" "$flag" "$value";;
            *) die "unknown option '$flag'";;
        esac
    done
    shift   # --end--

    printed=0
    if [ -z "$out" ]; then
        # A private per-user directory: Ghost refuses to write an answer into a shared one (/tmp) or through a link.
        answers="${TMPDIR:-}"
        if [ -z "$answers" ]; then answers="$SUPPORT/harness"; mkdir -p "$answers"; chmod 700 "$answers"; fi
        out="${answers%/}/ghostctl-$$-$mode.json"
        printed=1
    fi
    rm -f "$out"

    if [ "$mode" = "autotab" ]; then set -- --autotab "$count" "$@"
    elif [ "$mode" = "probe-combobox" ]; then set -- --probe-combobox "$probe" "$@"
    else set -- "--$mode" "$@"; fi
    launch --args "$@" --out "$out"

    # The harness has its own deadline and always answers; this one only covers a host that never started.
    if [ -z "$timeout" ]; then
        whole="${delay%%.*}"
        case "$whole" in ''|*[!0-9]*) whole=0;; esac
        timeout=$(( whole + 60 ))
        # Each guarded press pays for one extra window capture (kGuardTimeBudget + slack), so wait that much longer.
        [ "$mode" = "autotab" ] && timeout=$(( timeout + count * (interval / 1000 + 2 + guarded * 3) ))
        [ "$mode" != "autotab" ] && [ "$guarded" -eq 1 ] && timeout=$(( timeout + 10 ))
    fi
    ticks=$(( timeout * 5 ))
    while [ ! -s "$out" ] && [ "$ticks" -gt 0 ]; do
        sleep 0.2
        ticks=$(( ticks - 1 ))
    done
    if [ ! -s "$out" ]; then
        echo "ghostctl: no answer in $out after ${timeout}s (see: ghostctl log)" >&2
        exit 2
    fi
    status=0
    grep -q '^  "error"' "$out" && status=1
    if [ "$printed" -eq 1 ]; then
        cat "$out"
        rm -f "$out"
    else
        echo "ghostctl: wrote $out" >&2
    fi
    exit "$status"
}

[ $# -ge 1 ] || usage
command="$1"; shift
case "$command" in
    trust|dump|dump-tree|autotab|probe-combobox) harness "$command" "$@";;
    run) launch; echo "ghostctl: Ghost is starting (menu bar). 'ghostctl log' shows what it does." >&2;;
    quit) pkill -f "$PROCESS_PATTERN" 2>/dev/null && echo "ghostctl: asked Ghost to quit" >&2 || echo "ghostctl: Ghost is not running" >&2;;
    log) if [ -f "$LOG" ]; then tail -n "${1:-40}" "$LOG"; else echo "ghostctl: no log yet at $LOG" >&2; fi;;
    selftest)
        lib="$(library)"
        [ -n "$lib" ] || die "no libghost.dylib: run 'make -C desktop lib'"
        GHOST_LIB="$lib" exec "$APP/Contents/MacOS/Ghost" --selftest;;
    -h|--help|help) usage;;
    *) die "unknown command '$command' (trust | dump | dump-tree | autotab N | probe-combobox LABEL | run | quit | log | selftest)";;
esac
