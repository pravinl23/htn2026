#!/bin/sh
# shabangctl: drive Shabang Desktop without a mouse (docs/desktop-realworld.md section 2).
#
#   shabangctl trust                         { "trusted": bool }
#   shabangctl dump      [options]           captured fields of the frontmost window (labels, never values)
#   shabangctl dump-tree [options]           raw AX tree, values reduced to their length
#   shabangctl next      [options]           what Shabang would PROPOSE here: page kind, ranked roles, the top row
#   shabangctl accept    [options]           TAKE the ghost that is on screen, as the Shabang key does, and report
#                                          what moved. The ONE command that actuates: it presses a real control.
#   shabangctl autotab N [options]           N real Tab presses through Shabang, one record per press; stops at a lock
#   shabangctl probe-combobox "How did" [options]   open ONE combo box, record what the AX tree shows, close it
#   shabangctl run                           start the menu-bar agent (a second copy exits on its own)
#   shabangctl quit                          stop every Shabang process
#   shabangctl log [LINES]                   tail ~/Library/Logs/Shabang/desktop.log
#   shabangctl selftest                      core + mapping self-test (needs no permission)
#
#   shabangctl scan --dry-run [--out FILE]       cold start: the consent plan, counts only, opens nothing
#   shabangctl scan --sources a,b [--out FILE]   run it; writes a VALUE-FREE report (no path, URL or value)
#   shabangctl scan --safe [--out FILE]          run every source that can raise no permission dialog
#   shabangctl scan --apply FILE                 apply the proposals that report marks accepted
#   shabangctl graph                             what Shabang knows: counts per kind and per source, and the file size
#   shabangctl forget --source KIND              remove exactly what one cold-start source produced
#   shabangctl forget --all                      delete everything Shabang has learned, now
#
#   `--safe` is the Dock, login items, how recently applications were used, what is installed and Chromium-family
#   history. Contacts, Safari, Mail and Calendar are reported as "needs permission: <what to click>", never touched.
#
#   options: --frontmost "App"  --expect-field "First Name"  --delay S  --interval MS  --depth N  --out FILE  --timeout S
#
#   --expect-field pins the PAGE. --frontmost only promises the APP is in front, never which tab: with
#   --expect-field the harness re-captures the window before the first Tab and before every later press and
#   refuses to post unless a captured label still matches, so a tab that changed costs zero keystrokes
#   ("stopped": "expect-field-missing"). Use it for every live run on a real site.
#
# Everything is launched through LaunchServices (`open -n ... --args`), never as a child of this shell: macOS
# judges a binary started from a terminal by the TERMINAL's Accessibility permission, not by Shabang's. Such a
# launch has no stdout, so the answer travels through --out; this script waits for that file and prints it.
# Exit status: 0 answer without an error, 1 answer with "error" (not trusted, locked out...), 2 no answer, 64 usage.
# This script never sends a key itself, and the harness can only ever send Tab.
set -eu

HERE="$(cd "$(dirname "$0")" && pwd)"
DESKTOP="$(cd "$HERE/.." && pwd)"
APP="${SHABANG_APP:-$DESKTOP/build/Shabang.app}"
SUPPORT="$HOME/Library/Application Support/Shabang"
LOG="$HOME/Library/Logs/Shabang/desktop.log"
PROCESS_PATTERN="Shabang.app/Contents/MacOS/Shabang"

usage() {
    sed -n '2,33p' "$0" | sed 's/^# \{0,1\}//'
    exit 64
}

# The cold-start tool: never through LaunchServices, so it cannot borrow Shabang.app's Accessibility grant, and it
# asks macOS for nothing at all.
scan_tool() {
    bin="$DESKTOP/build/shabang-scan"
    [ -x "$bin" ] || die "no build/shabang-scan: run 'make -C desktop scan-tool' first"
    echo "$bin"
}

die() {
    echo "shabangctl: $*" >&2
    exit 64
}

# The library the host should load: $SHABANG_LIB, else the fresh build, else whatever the host finds on its own
# (~/Library/Application Support/Shabang/libshabang.dylib after `make install-lib`).
library() {
    if [ -n "${SHABANG_LIB:-}" ]; then
        echo "$SHABANG_LIB"
    elif [ -f "$DESKTOP/build/libshabang.dylib" ]; then
        echo "$DESKTOP/build/libshabang.dylib"
    fi
}

# launch [--args ...]: `open -n -g` (new instance, never brought to the front: the window under test keeps focus).
launch() {
    [ -d "$APP" ] || die "no $APP: run 'make -C desktop app' first"
    lib="$(library)"
    if [ -z "$lib" ]; then
        open -n -g "$APP" "$@"
    elif open -h 2>&1 | grep -q -- '--env'; then
        open -n -g --env SHABANG_LIB="$lib" --env SHABANG_NO_PROMPT=1 "$APP" "$@"
    else
        # No `open --env` on this macOS: the host reads the path from lib-path.txt (its last lookup location).
        mkdir -p "$SUPPORT"
        printf '%s\n' "$lib" > "$SUPPORT/lib-path.txt"
        open -n -g "$APP" "$@"
    fi
}

# harness MODE [N] [options]
harness() {
    mode="$1"; shift
    count=""; probe=""
    if [ "$mode" = "autotab" ]; then
        [ $# -ge 1 ] || die "autotab needs a count: shabangctl autotab 12"
        count="$1"; shift
        case "$count" in ''|*[!0-9]*) die "autotab needs a whole number, got '$count'";; esac
    elif [ "$mode" = "probe-combobox" ]; then
        [ $# -ge 1 ] || die "probe-combobox needs a label: shabangctl probe-combobox \"How did you hear\""
        probe="$1"; shift
    fi
    out=""; delay=0; interval=450; timeout=""; guarded=0
    set -- "$@" --end--
    while [ "$1" != "--end--" ]; do
        flag="$1"; shift
        case "$flag" in
            --out|--delay|--interval|--depth|--frontmost|--expect-field|--timeout)
                [ "$1" != "--end--" ] || die "$flag needs a value"
                value="$1"; shift
                case "$flag" in
                    --out) case "$value" in /*) out="$value";; *) out="$PWD/$value";; esac; continue;;
                    --timeout) timeout="$value"; continue;;
                    --delay) delay="$value";;
                    --interval) interval="$value";;
                    --expect-field) guarded=1;;
                esac
                set -- "$@" "$flag" "$value";;
            *) die "unknown option '$flag'";;
        esac
    done
    shift   # --end--

    printed=0
    if [ -z "$out" ]; then
        # A private per-user directory: Shabang refuses to write an answer into a shared one (/tmp) or through a link.
        answers="${TMPDIR:-}"
        if [ -z "$answers" ]; then answers="$SUPPORT/harness"; mkdir -p "$answers"; chmod 700 "$answers"; fi
        out="${answers%/}/shabangctl-$$-$mode.json"
        printed=1
    fi
    rm -f "$out"

    if [ "$mode" = "autotab" ]; then set -- --autotab "$count" "$@"
    elif [ "$mode" = "probe-combobox" ]; then set -- --probe-combobox "$probe" "$@"
    else set -- "--$mode" "$@"; fi
    launch --args "$@" --out "$out"

    # The harness has its own deadline and always answers; this one only covers a host that never started.
    if [ -z "$timeout" ]; then
        whole="${delay%%.*}"
        case "$whole" in ''|*[!0-9]*) whole=0;; esac
        timeout=$(( whole + 60 ))
        # Each guarded press pays for one extra window capture (kGuardTimeBudget + slack), so wait that much longer.
        [ "$mode" = "autotab" ] && timeout=$(( timeout + count * (interval / 1000 + 2 + guarded * 3) ))
        [ "$mode" != "autotab" ] && [ "$guarded" -eq 1 ] && timeout=$(( timeout + 10 ))
    fi
    ticks=$(( timeout * 5 ))
    while [ ! -s "$out" ] && [ "$ticks" -gt 0 ]; do
        sleep 0.2
        ticks=$(( ticks - 1 ))
    done
    if [ ! -s "$out" ]; then
        echo "shabangctl: no answer in $out after ${timeout}s (see: shabangctl log)" >&2
        exit 2
    fi
    status=0
    grep -q '^  "error"' "$out" && status=1
    if [ "$printed" -eq 1 ]; then
        cat "$out"
        rm -f "$out"
    else
        echo "shabangctl: wrote $out" >&2
    fi
    exit "$status"
}

[ $# -ge 1 ] || usage
command="$1"; shift
case "$command" in
    trust|dump|dump-tree|next|accept|autotab|probe-combobox) harness "$command" "$@";;
    scan)
        # Deliberately NOT through LaunchServices: the scan must not borrow Shabang.app's Accessibility grant, and
        # it asks macOS for nothing (a protected source is reported as "needs permission: ...", never probed).
        # It refuses to start while another scan holds ~/Library/Application Support/Shabang/coldstart.lock.
        [ $# -ge 1 ] || die "scan needs --dry-run, --safe, --sources a,b or --apply FILE"
        exec "$(scan_tool)" "$@";;
    graph) exec "$(scan_tool)" --graph "$@";;
    forget)
        [ $# -ge 1 ] || die "forget needs --source KIND or --all"
        case "$1" in
            --all) exec "$(scan_tool)" --forget-all;;
            --source)
                [ $# -ge 2 ] || die "forget --source needs a source kind (dock, recent-apps, browser-history...)"
                exec "$(scan_tool)" --forget "$2";;
            *) die "forget takes --source KIND or --all, not '$1'";;
        esac;;
    run) launch; echo "shabangctl: Shabang is starting (menu bar). 'shabangctl log' shows what it does." >&2;;
    quit) pkill -f "$PROCESS_PATTERN" 2>/dev/null && echo "shabangctl: asked Shabang to quit" >&2 || echo "shabangctl: Shabang is not running" >&2;;
    log) if [ -f "$LOG" ]; then tail -n "${1:-40}" "$LOG"; else echo "shabangctl: no log yet at $LOG" >&2; fi;;
    selftest)
        lib="$(library)"
        [ -n "$lib" ] || die "no libshabang.dylib: run 'make -C desktop lib'"
        SHABANG_LIB="$lib" exec "$APP/Contents/MacOS/Shabang" --selftest;;
    -h|--help|help) usage;;
    *) die "unknown command '$command' (trust | dump | dump-tree | next | accept | autotab N | probe-combobox LABEL | scan | graph | forget | run | quit | log | selftest)";;
esac
