{
  "name": "ghost",
  "private": true,
  "version": "0.1.0",
  "description": "Ghost: Cursor Tab for your whole computer",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "concurrently -n server,demo -c blue,green \"pnpm --filter @shabang/server dev\" \"pnpm --filter @shabang/demo dev\"",
    "build": "pnpm --filter @shabang/demo build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --workspace-concurrency=1 test && pnpm eval:walk-replays",
    "test:live": "node scripts/test-live.mjs",
    "test:terminal": "if command -v zsh >/dev/null 2>&1; then zsh -f terminal/tests/ghost.test.zsh; else echo 'test:terminal skipped: zsh is not installed'; fi",
    "eval:walk-replays": "pnpm --filter @shabang/server eval:walk-replays",
    "desktop": "make -C desktop",
    "desktop:test": "make -C desktop test"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "esbuild": "^0.25.12",
    "typescript": "^5.7.3"
  }
}
