{
  "name": "@ghost/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../.env src/index.ts",
    "bundle": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "baseten:models": "node ../scripts/bench-providers.mjs --models",
    "bench:providers": "node ../scripts/bench-providers.mjs",
    "eval:walk-replays": "tsx scripts/walkReplays.ts",
    "eval:learning-loop": "tsx scripts/walkReplays.ts"
  },
  "dependencies": {
    "@ghost/shared": "workspace:*",
    "@hono/node-server": "^1.13.8",
    "@sentry/node": "^10.75.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "ai": "^7.0.107",
    "hono": "^4.7.2",
    "playwright-core": "1.63.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
