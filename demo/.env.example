# Demo site environment. Copy to demo/.env.local for a local build; never commit a real file.
#
# VITE_SENTRY_DSN is the Sentry project "ghost-web" DSN (error monitoring, tracing, logs, Session Replay).
# A browser DSN is public by design - it is embedded in the bundle - but it still does not belong in git.
# Leave it empty and the demo initialises no SDK at all: no replay, no spans, no network.
#
# Three places it can come from, first match wins (demo/vite.config.ts):
#   1. VITE_SENTRY_DSN in demo/.env.local or the build environment (this is how the deployed demo gets it)
#   2. VITE_SENTRY_DSN in the repo-root .env
#   3. SENTRY_WEB_DSN in the repo-root .env (the name the rest of the repo already uses)
VITE_SENTRY_DSN=

# Optional: tags every event with a release so a regression can be pinned to a build.
VITE_SENTRY_RELEASE=
